# Supabase PostgreSQL connection

SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# MBIE / Tenancy Services Market Rent API

# Use "sandbox" during development.
# Change to "production" only when the pipeline is ready.
MARKET_RENT_API_ENV=sandbox

# Subscription keys.
# Never put real keys in this example file.
MARKET_RENT_API_SANDBOX_KEY=
MARKET_RENT_API_PROD_KEY=
