# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Build / packaging
build/
dist/
*.egg-info/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Streamlit secrets
.streamlit/secrets.toml

# Project data directories
data/raw/*
!data/raw/.gitkeep

data/staging/*
!data/staging/.gitkeep

data/processed/*
!data/processed/.gitkeep

# data/reference/ is intentionally not ignored.
# Small geographic reference/concordance files may be version controlled.
